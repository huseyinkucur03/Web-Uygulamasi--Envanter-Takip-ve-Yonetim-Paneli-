@{
	Layout = null;
}

@model Kullanicilar

<!DOCTYPE html>
<html lang="en">
<head>
	<title>Login V15</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<!--===============================================================================================-->
	<link rel="icon" type="image/png" href="~/images/icons/favicon.ico" />
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/vendor/bootstrap/css/bootstrap.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/fonts/Linearicons-Free-v1.0.0/icon-font.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/vendor/animate/animate.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/vendor/css-hamburgers/hamburgers.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/vendor/animsition/css/animsition.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/vendor/select2/select2.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/vendor/daterangepicker/daterangepicker.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/css/util.css">
	<link rel="stylesheet" type="text/css" href="~/css/main.css">
	<!--===============================================================================================-->
</head>
<body>

	<div class="limiter">
		<div class="container-login100">
			<div class="wrap-login100">
				<div class="login100-form-title" style="background-image: url(images/bg-01.jpg);">
					<span class="login100-form-title-1">
						Kayıt Ol
					</span>
				</div>

				<form asp-action="Register" asp-controller="Giris" method="post" class="login100-form validate-form">
					<div class="wrap-input100 validate-input m-b-26" data-validate="Ad gereklidir">
						<span class="label-input100">Ad</span>
						<input class="input100" type="text" name="Ad" placeholder="Ad">
						<span class="focus-input100"></span>
					</div>

					<div class="wrap-input100 validate-input m-b-26" data-validate="Soyad gereklidir">
						<span class="label-input100">Soyad</span>
						<input class="input100" type="text" name="Soyad" placeholder="Soyad">
						<span class="focus-input100"></span>
					</div>

					<div class="wrap-input100 validate-input m-b-26" data-validate="Kullanıcı Adı gereklidir">
						<span class="label-input100">Kullanıcı Adı</span>
						<input class="input100" type="text" name="KullaniciAdi" placeholder="Kullanıcı Adı">
						<span class="focus-input100"></span>
					</div>
					@if (TempData["MevcutKullaniciHatasi"] != null)
					{
						<div class="alert alert-danger">
							@TempData["MevcutKullaniciHatasi"]
						</div>
					}

					<div class="wrap-input100 validate-input m-b-26" data-validate="E-posta gereklidir">
						<span class="label-input100">E-posta</span>
						<input class="input100" type="email" name="Eposta" placeholder="E-posta">
						<span class="focus-input100"></span>
					</div>
					@if (TempData["MevcutEpostaHatasi"] != null)
					{
						<div class="alert alert-danger">
							@TempData["MevcutEpostaHatasi"]
						</div>
					}
					<div class="wrap-input100 validate-input m-b-26" data-validate="Telefon Numarası gereklidir">
						<span class="label-input100">Telefon Numarası</span>
						<input class="input100" type="text" name="TelNo" placeholder="Telefon Numarası" maxlength="11">
						<span class="focus-input100"></span>
					</div>

					<div class="wrap-input100 validate-input m-b-26" data-validate="Adres gereklidir">
						<span class="label-input100">Adres</span>
						<select class="input100" name="Adres">
							<option value="">Lütfen bir adres seçin</option>
							<option value="Afyonkarahisar">Afyonkarahisar</option>
							<option value="Eskişehir">Eskişehir</option>
						</select>
						<span class="focus-input100"></span>
					</div>

					<div class="wrap-input100 validate-input m-b-18" data-validate="Şifre gereklidir">
						<span class="label-input100">Şifre</span>
						<input class="input100" type="password" name="Sifre" placeholder="Şifre" minlength="6">
						<span class="focus-input100"></span>
					</div>
					
					<div class="wrap-input100 validate-input m-b-18" data-validate="Şifre gereklidir">
						<span class="label-input100">Şifre Tekrar</span>
						<input class="input100" type="password" name="SifreTekrar" placeholder="Şifre Tekrar" minlength="6">
						<span class="focus-input100"></span>
					</div>

					@if (TempData["SifreUyusmuyor"] != null)
					{
						<div class="alert alert-danger">
							@TempData["SifreUyusmuyor"]
						</div>	
					}

					<div class="container-login100-form-btn">
						<button class="login100-form-btn">
							Kayıt Ol
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!--===============================================================================================-->
	<script src="~/vendor/jquery/jquery-3.2.1.min.js"></script>
	<!--===============================================================================================-->
	<script src="~/vendor/animsition/js/animsition.min.js"></script>
	<!--===============================================================================================-->
	<script src="~/vendor/bootstrap/js/popper.js"></script>
	<script src="~/vendor/bootstrap/js/bootstrap.min.js"></script>
	<!--===============================================================================================-->
	<script src="~/vendor/select2/select2.min.js"></script>
	<!--===============================================================================================-->
	<script src="~/vendor/daterangepicker/moment.min.js"></script>
	<script src="~/vendor/daterangepicker/daterangepicker.js"></script>
	<!--===============================================================================================-->
	<script src="~/vendor/countdowntime/countdowntime.js"></script>
	<!--===============================================================================================-->
	<script src="~/js/main.js"></script>

</body>
</html>
