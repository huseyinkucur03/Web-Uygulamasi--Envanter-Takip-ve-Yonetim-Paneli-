
@{
    ViewData["Title"] = "KullaniciGuncelle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Kullanicilar

<h1>KullaniciGuncelle</h1>

<div class="container">
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            Kullanıcı Bilgileri
        </div>
        <div class="card-body">
            <form asp-controller="Kullanici" asp-action="KullaniciGuncelle" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Ad" class="control-label">Ad</label>
                            <input asp-for="Ad" class="form-control" />
                            <span asp-validation-for="Ad" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Soyad" class="control-label">Soyad</label>
                            <input asp-for="Soyad" class="form-control" />
                            <span asp-validation-for="Soyad" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="TelNo" class="control-label">Telefon Numarası</label>
                            <input asp-for="TelNo" class="form-control" />
                            <span asp-validation-for="TelNo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="KullaniciAdi" class="control-label">Kullanıcı Adı</label>
                            <input asp-for="KullaniciAdi" class="form-control" />
                            <span asp-validation-for="KullaniciAdi" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Eposta" class="control-label">E-Posta</label>
                            <input asp-for="Eposta" class="form-control" />
                            <span asp-validation-for="Eposta" class="text-danger"></span>
                        </div>

                        <div class="wrap-input100 validate-input m-b-26" data-validate="Adres gereklidir">
                            <span class="label-input100">Adres</span>
                            <select asp-for="Adres" class="input100">
                                <option value="">Lütfen bir adres seçin</option>
                                <option value="Afyonkarahisar">Afyonkarahisar</option>
                                <option value="Eskişehir">Eskişehir</option>
                            </select>
                            <span class="focus-input100"></span>
                        </div>
                    </div>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-success" onclick="return confirm('Üründe güncelleme yapmak istediğinize emin misiniz?');">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>