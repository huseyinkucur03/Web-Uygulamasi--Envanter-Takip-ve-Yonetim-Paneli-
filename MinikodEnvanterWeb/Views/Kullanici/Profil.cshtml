@{
    ViewData["Title"] = "Profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Kullanicilar

<h1 class="text-center">Profil</h1>

<div class="container">
    <div class="card mb-4 mx-auto" style="max-width: 800px;">
        <div class="card-header bg-primary text-white">
            Kullanıcı Bilgileri
        </div>
        <div class="card-body">
            <form asp-controller="Kullanici" asp-action="Profil" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="form-group mb-3">
                            <label asp-for="Ad" class="control-label">Ad</label>
                            <input asp-for="Ad" class="form-control" />
                            <span asp-validation-for="Ad" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Soyad" class="control-label">Soyad</label>
                            <input asp-for="Soyad" class="form-control" />
                            <span asp-validation-for="Soyad" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="KullaniciAdi" class="control-label">Kullanıcı Adı</label>
                            <input asp-for="KullaniciAdi" class="form-control" />
                            <span asp-validation-for="KullaniciAdi" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Eposta" class="control-label">E-Posta</label>
                            <input asp-for="Eposta" class="form-control" />
                            <span asp-validation-for="Eposta" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="TelNo" class="control-label">Telefon Numarası</label>
                            <input asp-for="TelNo" class="form-control" />
                            <span asp-validation-for="TelNo" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Sifre" class="control-label">Şifre</label>
                            <input asp-for="Sifre" class="form-control" type="password"/>
                            <span asp-validation-for="Sifre" class="text-danger"></span>
                        </div>  
                        
                        <div class="form-group mb-3">
                            <label asp-for="Sifre" class="control-label">Şifre Tekrar</label>
                            <input asp-for="Sifre" name="SifreTekrar" class="form-control" type="password"/>
                            <span asp-validation-for="Sifre" class="text-danger"></span>
                        </div>

                        @if (TempData["SifreUyusmuyor"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["SifreUyusmuyor"]
                            </div>
                        }

                    </div>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-success" onclick="return confirm('Bilgilerinizi güncellemek istediğinize emin misiniz?');">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>
